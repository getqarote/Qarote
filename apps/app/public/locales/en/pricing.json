  "questions": {
    "title": "Pricing questions",
    "items": {
      "billing": {
        "q": "How does billing work?",
        "a": "Cloud is a subscription via Stripe — monthly or yearly (yearly saves ~20%). Self-hosted tiers are annual licenses validated offline. Community is free forever. All prices above are placeholders pending confirmation."
      },
      "selfHostedCloud": {
        "q": "Self-hosted or cloud — what's the difference?",
        "a": "Same product. Cloud is managed by us; self-hosted runs in your network via Docker, Compose, Dokku, or a binary, with an offline JWT license (no phone-home). Self-hosted AI Explain can run on a local Ollama model so nothing leaves your network."
      },
      "quota": {
        "q": "What counts toward the AI Explain quota?",
        "a": "Only managed explanations (Enterprise's zero-config LLM) are metered per month. If you bring your own key or run local Ollama, usage is unlimited — you pay your own LLM cost. Repeated identical explanations are cached and don't count."
      },
      "switching": {
        "q": "Can I switch plans or models later?",
        "a": "Yes. Upgrade, downgrade, or move between cloud and self-hosted any time. Downgrades take effect at the end of the billing period; the open-source core keeps running regardless."
      }
    }
  }
