}

enum UserPlan {
  FREE
  DEVELOPER
  ENTERPRISE
}

/// Workspace-scoped role. Strictly separate from OrgRole.
/// OWNER is workspace-only and gates `workspace:delete` and ownership transfer.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  READONLY
}

/// WorkspaceRole minus OWNER. Invitations cannot grant OWNER — ownership
/// transfer is a separate, explicit flow (rbac.md §2.2).
enum InviteRole {
  ADMIN
  MEMBER
  READONLY
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Organization Models ──────────────────────────────────────────────

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  contactEmail         String?
  logoUrl              String?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members      OrganizationMember[]
  invitations  OrganizationInvitation[]
  workspaces   Workspace[]
  subscription Subscription?
  orgSsoConfig OrgSsoConfig?
  auditLogs    AuditLog[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id                   String    @id @default(uuid())
  organizationId       String
  email                String
  /// SHA-256 hex of the raw token. Raw token is never stored — only sent
  /// to the invitee via email and compared on accept.
  tokenHash            String    @unique
  role                 OrgRole   @default(MEMBER)
  invitedById          String
  expiresAt            DateTime
  acceptedAt           DateTime?
  createdAt            DateTime  @default(now())
  workspaceAssignments Json      @default("[]")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrgInvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
}

// ─── Self-hosted Configuration ───────────────────────────────────────
// Generic key-value store for self-hosted instance settings
/// User-facing configuration persisted across restarts.
/// Primary use: storing the activated license JWT (key = "license").
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Marketing ───────────────────────────────────────────────────────
enum QuizLeadTier {
  reactive
  proactive
  production_grade @map("production-grade")
}

model QuizLead {
  id        String       @id @default(uuid())
  email     String       @db.VarChar(255)
  tier      QuizLeadTier
  score     Int
  ipHash    String?      @db.VarChar(64)
  source    String?      @db.VarChar(64)
  createdAt DateTime     @default(now())

  @@index([email])
  @@index([createdAt])
}

/// Append-only log of operator-initiated actions a self-hosted admin
/// (or compliance auditor) may want to inspect after the fact.
///
/// Operator-facing audit table — captures every admin-relevant
/// mutation across the application (RabbitMQ ops, workspace/org
/// changes, role grants, integration CRUD, etc.) plus authorization
/// denials (R-AUDIT-1). Subsumes the v1 capability-recheck audit.
///
/// **Plan-gating**: writes only persist on Enterprise plan (the
/// service `recordAuditLog()` no-ops for Free/Developer). Pino logs
/// continue across all plans for ops debug.
///
/// **Append-only**: a Postgres BEFORE UPDATE/DELETE trigger blocks
/// ad-hoc mutations. The 90-day retention cron uses
/// `session_replication_role = 'replica'` to bypass the trigger
/// inside its own transaction.
///
/// **action**: dotted-string taxonomy `<category>.<entityType>.<verb>`.
/// Adding an action does not require a migration.
///
/// **vhost**: top-level (not in metadata) so the LLM "recent config
/// changes on this queue" query (`docs/internal/llm-situated-explanation`)
/// hits the index directly.
model AuditLog {
  id          String      @id @default(uuid())
  timestamp   DateTime    @default(now())
  /// Qarote user who performed the action; null for system-triggered
  /// events (cron-driven actions, broker_diff in Phase 2).
  actorId     String?
  /// Denormalized for readability after user deletion. On GDPR erasure
  /// we overwrite to "[deleted user]" — never null after creation.
  actorEmail  String?
  source      AuditSource @default(qarote)
  /// Dotted notation, e.g. "rabbitmq.queue.purge", "auth.denial.member:invite".
  action      String
  /// First segment of `action` for indexable category-based filtering.
  category    String
  entityType  String
  entityId    String?
  entityLabel String?
  serverId    String?
  vhost       String?
  workspaceId String?
  /// Org-level events (license / SSO / auth) carry organizationId so
  /// the row is attributable to a tenant when no workspace exists.
  /// Workspace-scoped events leave this null. Both can coexist —
  /// workspace events tied to an org workspace will populate both,
  /// letting org-wide queries surface them too.
  organizationId String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  server       RabbitMQServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Workspace-prefixed composites for the dominant filter shapes —
  // single-column indexes that ignore the workspaceId narrowing are
  // not included by design.
  @@index([workspaceId, timestamp(sort: Desc)])
  @@index([workspaceId, source, timestamp(sort: Desc)])
  @@index([workspaceId, category, timestamp(sort: Desc)])
  @@index([workspaceId, actorId, timestamp(sort: Desc)])
  // LLM PR 7 query path: "last N changes on queue X on server Y".
  @@index([serverId, vhost, entityId, timestamp(sort: Desc)])
  // The functional+partial index for permissionsLastSet
  // (`audit_logs_perm_set_idx`) is created in raw SQL and not
  // expressible in the Prisma schema. See the migration.
  // Snake_case table name preserved from the v1 capability-recheck
  // audit — kept to match the migration history without table renames.
  @@map("audit_logs")
}

enum AuditSource {
  /// Mutation performed via Qarote UI / API (the default).
  qarote
  /// Phase 2: detected by poll-based diffing of broker state.
  broker_diff
  /// R-AUDIT-1: authorization denied (failed permission check).
  rbac_denial
}

/// Persisted diagnosis findings, deduplicated by `(serverId, fingerprint)`.
/// Re-firing the same rule on the same target updates `lastSeenAt` rather
/// than creating a new row — the engine writes O(rules × targets) per cold
/// cycle and degenerates to O(updates) on warm cycles. See
/// `apps/api/src/ee/services/incident/dedup.ts` for fingerprint composition.
///
/// Lifecycle: a record without a `resolvedAt` is "open"; the engine flips
/// `resolvedAt` when the rule no longer fires for that fingerprint and the
/// previous `lastSeenAt` is older than the dedup TTL.
model IncidentDiagnosisRecord {
  id             String        @id @default(uuid())
  serverId       String
  /// Denormalised for tenant-scoped queries without joining through server.
  /// Kept in sync at write time (no FK).
  workspaceId    String
  /// Stable hash of (scope, ruleId, queueName, vhost). Identical re-firings
  /// collide on this column and use the unique constraint below to drive
  /// upsert. `scope` is part of the input so a queue-scoped finding can
  /// never collide with a broker-scoped one for the same rule.
  fingerprint    String
  /// Discriminator: "queue" — finding ties to a specific (queueName, vhost);
  /// "broker" — cluster-scoped (alarms, flow-control, channel leak), and
  /// queueName/vhost are empty strings on the wire.
  scope          String
  ruleId         String
  queueName      String
  vhost          String
  severity       AlertSeverity
  /// Defense-in-depth length caps. Backend rules generate these strings
  /// today, but a buggy rule emitting a multi-MB description would
  /// otherwise persist verbatim. 2 KB is generous for human-readable
  /// diagnostic text; larger detail belongs in linked docs.
  description    String        @db.VarChar(2000)
  recommendation String        @db.VarChar(2000)
  /// When set, another rule's firing on the same target supersedes this one.
  supersededBy   String?
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  resolvedAt     DateTime?

  server          RabbitMQServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  llmExplanations LlmExplanation[]

  @@unique([serverId, fingerprint])
  @@index([workspaceId, lastSeenAt])
  @@index([serverId, lastSeenAt])
  @@index([resolvedAt])
  @@map("incident_diagnosis_records")
}

/// Configuration findings produced by the CONFIG evaluator. Lifecycle is
/// upsert-on-fingerprint per scan: the evaluator sets `lastSeenAt` on every
/// pass; rows whose `lastSeenAt` is older than the current scan timestamp
/// are auto-resolved (`resolvedAt` set). No notifications, no acknowledge
/// semantics — this is a stateless config catalog, not an alert stream.
model ConfigFinding {
  id           String        @id @default(uuid())
  workspaceId  String
  serverId     String
  ruleKey      String
  severity     AlertSeverity
  resourceType String
  resourceName String
  vhost        String?
  fingerprint  String
  detectedAt   DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  resolvedAt   DateTime?
  details      Json?

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  server          RabbitMQServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  llmExplanations LlmExplanation[]

  @@unique([fingerprint])
  @@index([serverId, resolvedAt])
  @@index([workspaceId, severity])
  @@index([ruleKey])
}

/// Per-workspace, per-rule kill switch. Default enabled (a missing row
/// means the rule is on); support / admin tooling toggles `enabled = false`
/// to silence a rule that's misbehaving for one tenant without a release.
model DiagnosisRuleConfig {
  workspaceId String
  ruleId      String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, ruleId])
  @@index([workspaceId, enabled])
  @@map("diagnosis_rule_configs")
}

/// Persisted LLM explanation for a finding or trace event.
/// Exactly one of incidentFindingId / configFindingId / traceEventId is non-null,
/// enforced by a CHECK constraint added in the migration SQL.
/// Soft-deleted on regenerate (supersededAt set) so old permalinks resolve to a
/// banner-flagged historical version instead of 404ing.
model LlmExplanation {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")

  incidentFindingId String?   @map("incident_finding_id")
  configFindingId   String?   @map("config_finding_id")
  traceEventId      String?   @map("trace_event_id")

  promptVersion     String    @map("prompt_version")
  provider          String
  model             String
  content           String    @db.Text
  inputTokens       Int       @map("input_tokens")
  outputTokens      Int       @map("output_tokens")

  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")

  supersededBy      String?   @map("superseded_by")
  supersededAt      DateTime? @map("superseded_at")

  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incidentFinding  IncidentDiagnosisRecord? @relation(fields: [incidentFindingId], references: [id], onDelete: Restrict)
  configFinding    ConfigFinding?           @relation(fields: [configFindingId], references: [id], onDelete: Restrict)
  traceEvent       MessageTraceEvent?       @relation(fields: [traceEventId], references: [id], onDelete: Restrict)
  creator          User?                    @relation("LlmExplanationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([incidentFindingId])
  @@index([configFindingId])
  @@index([traceEventId])
  @@map("llm_explanations")
}

/// Monthly usage counter for Managed LLM calls. One row per workspace per
/// calendar-month-start (UTC). Composite PK serves the only read pattern
/// (per-workspace + current period lookup in the gate) and the UPSERT
/// in `recordUsage`. Period rollover is implicit — a new row is created
/// on the first call of each month, old rows are retained for analytics
/// (no PII beyond workspaceId, which is GDPR-covered via Cascade).
///
/// The counter is OPERATIONAL, not billing-of-record: Stripe + the
/// Anthropic invoice are the source-of-truth for finance reconciliation,
/// PostHog `llm_quota_recorded` events are the audit trail.
model LlmUsageCounter {
  workspaceId  String   @map("workspace_id")
  periodStart  DateTime @map("period_start")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  callCount    Int      @default(0) @map("call_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, periodStart])
  @@map("llm_usage_counters")
}
