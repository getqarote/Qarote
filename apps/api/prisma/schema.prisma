generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LlmProvider {
  OLLAMA
  ANTHROPIC
  OPENAI
  MANAGED
}

enum TraceDirection {
  publish
  deliver
}

model Alert {
  id             String          @id @default(uuid())
  title          String
  description    String
  severity       AlertSeverity
  status         AlertStatus     @default(ACTIVE)
  workspaceId    String
  createdById    String?
  alertRuleId    String?
  threshold      Float?
  value          Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  // Unified fields — populated for system-detected alerts, optional for custom rule alerts
  serverId       String?
  serverName     String?
  fingerprint    String?
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?
  emailSentAt      DateTime?
  slackNotifiedAt  DateTime?
  webhookNotifiedAt DateTime?
  lastNotifiedAt   DateTime?
  category       String?
  sourceType     String?
  sourceName     String?
  details        Json?
  duration       BigInt?
  alertRule      AlertRule?      @relation(fields: [alertRuleId], references: [id])
  user           User?           @relation(fields: [createdById], references: [id])
  server         RabbitMQServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([serverId, status])
  // NOTE: Prisma cannot express partial unique indexes, so the real invariant
  // "one ACTIVE alert per fingerprint" is enforced by a hand-written raw SQL
  // partial unique index named `alert_active_fingerprint_unique`:
  //   CREATE UNIQUE INDEX "alert_active_fingerprint_unique"
  //     ON "Alert" (fingerprint)
  //     WHERE status = 'ACTIVE' AND fingerprint IS NOT NULL;
  // This index is created in migration
  // 20260316141713_phase_2_migrate_seen_resolved_to_alert/migration.sql.
  // @@index([fingerprint]) below is a plain (non-unique, non-partial) index
  // kept only for query performance. Do NOT remove or replace the raw SQL
  // partial unique index with a Prisma-managed one — Prisma will drop it on
  // the next `migrate dev` run unless the DROP INDEX is manually removed from
  // the generated migration file and the index is restored via `prisma db execute`.
  @@index([fingerprint])
  @@index([resolvedAt])
  @@index([createdAt])
}

model AlertRule {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  slug                  String?
  type                  AlertType
  threshold             Float
  operator              ComparisonOperator
  severity              AlertSeverity
  enabled               Boolean            @default(true)
  isDefault             Boolean            @default(false)
  serverId              String?
  createdById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workspaceId           String
  /// Discriminator for which evaluator runs this rule. METRIC rules are evaluated
  /// by alert.analyzer; CONFIG rules by config.evaluator.
  evaluator             AlertEvaluator     @default(METRIC)
  /// Per-rule evaluation cadence in seconds. Null = use the worker default
  /// (30s for METRIC, 600s for CONFIG).
  evaluationIntervalSec Int?
  /// Stable string ID for CONFIG rules (e.g. "config.queue.missing_dlx").
  /// Doubles as i18n bundle key. Null for METRIC rules.
  configRuleKey         String?
  alerts                Alert[]
  user                  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  server                RabbitMQServer?    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([serverId, slug])
  @@index([serverId])
  @@index([workspaceId])
  @@index([isDefault])
  @@index([serverId, evaluator])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  email     String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Invitation {
  id               String           @id @default(uuid())
  email            String
  /// SHA-256 hex of the raw token. Raw token is never stored — only sent to
  /// the invitee via email and compared in constant time on accept.
  /// docs/plans/rbac.md §2.5 (R-INV-1).
  tokenHash        String           @unique
  invitedById      String
  invitedUserId    String?
  acceptedByUserId String?
  /// Workspace-scoped role minus OWNER (see InviteRole). Ownership transfer
  /// is a separate, explicit flow.
  role             InviteRole       @default(MEMBER)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspaceId      String
  invitedBy        User             @relation("Invitation_invitedByIdToUser", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser      User?            @relation("Invitation_invitedUserIdToUser", fields: [invitedUserId], references: [id])
  acceptedBy       User?            @relation("Invitation_acceptedByIdToUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model Queue {
  id            String         @id @default(uuid())
  name          String
  vhost         String
  serverId      String
  messages      BigInt
  messagesReady BigInt
  messagesUnack BigInt
  lastFetched   DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  server        RabbitMQServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([name, vhost, serverId])
}

model RabbitMQServer {
  id                    String                    @id @default(uuid())
  name                  String
  host                  String
  port                  Int
  username              String
  password              String
  vhost                 String                    @default("/")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  sslVerifyPeer         Boolean                   @default(true)
  workspaceId           String?
  version               String?
  versionMajorMinor     String?
  isOverQueueLimit      Boolean                   @default(false)
  overLimitWarningShown Boolean                   @default(false)
  queueCountAtConnect   Int?
  /// Free-text environment tag (`prod`, `staging`, `dev`, …) consumed
  /// by the RBAC Phase 3 `server.environment` resource-scope
  /// predicate. Operator-controlled — no automated derivation.
  environment           String?
  useHttps              Boolean                   @default(false)
  queuePauseStates      Json?
  amqpPort              Int                       @default(5672)
  traceEnabled          Boolean                   @default(false)
  payloadCaptureEnabled Boolean                   @default(false)
  // Broker capability snapshot — see services/feature-gate/capability-axis.ts.
  // `version` (above) already stores rabbitmq_version; productName captures
  // the product flavour (RabbitMQ / Tanzu RabbitMQ / AWS MQ for RabbitMQ /…).
  productName           String?
  capabilities          Json?
  capabilitiesAt        DateTime?
  // Support-only override merged on top of detected snapshot. Read-only from
  // app code; writable through admin tooling for misclassified brokers.
  capabilityOverride    Json?
  alertRules            AlertRule[]
  alerts                Alert[]
  queues                Queue[]
  queueMetricSnapshots  QueueMetricSnapshot[]
  messageTraceEvents    MessageTraceEvent[]
  auditLogs             AuditLog[]
  diagnosisRecords      IncidentDiagnosisRecord[]
  configFindings        ConfigFinding[]
  workspace             Workspace?                @relation(fields: [workspaceId], references: [id])
}

/// Scheduled time-series snapshots written every 5 min by the metrics poller.
/// Replaces QueueMetric — independent of user activity, includes consumerCount.
/// Retention: 7 days enforced by runRetentionCleanup() in queue-metrics.service.ts.
/// Never written when workspaceId is null (orphaned rows have no consumer).
/// workspaceId is denormalized (no FK) — server reassignment requires a backfill migration.
model QueueMetricSnapshot {
  id            String         @id @default(cuid())
  serverId      String
  workspaceId   String
  queueName     String
  vhost         String
  messages      BigInt
  messagesReady BigInt
  messagesUnack BigInt
  publishRate   Float
  consumeRate   Float
  consumerCount Int
  timestamp     DateTime       @default(now())
  server        RabbitMQServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, queueName, vhost, timestamp])
  @@index([serverId, timestamp])
  @@index([timestamp])
  @@index([workspaceId, serverId, timestamp])
  @@index([workspaceId, serverId, queueName, vhost, timestamp])
  @@map("queue_metric_snapshots")
}

model User {
  id                      String                   @id @default(uuid())
  name                    String                   @default("")
  email                   String                   @unique
  image                   String?
  passwordHash            String?
  firstName               String
  lastName                String
  isActive                Boolean                  @default(true)
  lastLogin               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  workspaceId             String?
  emailVerified           Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  pendingEmail            String?
  googleId                String?                  @unique
  ssoSubjectId            String?                  @unique
  locale                  String                   @default("en")
  discordJoined           Boolean                  @default(false)
  discordJoinedAt         DateTime?
  onboardingCompletedAt   DateTime?
  referralSource          String?
  discoveryQuery          String?
  alerts                  Alert[]
  alertRules              AlertRule[]
  emailVerificationTokens EmailVerificationToken[]
  invitationsSent         Invitation[]             @relation("Invitation_invitedByIdToUser")
  invitationsReceived     Invitation[]             @relation("Invitation_invitedUserIdToUser")
  invitationsAccepted     Invitation[]             @relation("Invitation_acceptedByIdToUser")
  passwordResets          PasswordReset[]
  sessions                Session[]
  accounts                Account[]
  workspace               Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workspaceMembers        WorkspaceMember[]        @relation("WorkspaceMembers")
  payments                Payment[]
  subscription            Subscription?
  organizationMembers     OrganizationMember[]
  orgInvitationsSent      OrganizationInvitation[] @relation("OrgInvitationsSent")
  auditLogs               AuditLog[]
  llmConfigs              WorkspaceLlmConfig[]
  rolesCreated            Role[]                   @relation("RoleCreator")
  llmExplanations         LlmExplanation[]         @relation("LlmExplanationCreator")
}

// ─── Better Auth Models ─────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ────────────────────────────────────────────────────────────────────

model Workspace {
  id                            String                   @id @default(uuid())
  name                          String
  contactEmail                  String?
  logoUrl                       String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  ownerId                       String?
  organizationId                String
  tags                          Json?
  emailNotificationsEnabled     Boolean                  @default(true)
  notificationSeverities        Json?
  browserNotificationsEnabled   Boolean                  @default(false)
  browserNotificationSeverities Json?
  notificationServerIds         Json?
  unackedWarnThreshold          Int                      @default(100)
  vhostThresholds               Json?
  /// Message tracing retention window in hours. Default 24h, max 168h (7 days).
  traceRetentionHours           Int                      @default(24)
  /// Denormalized license tier for fast plan-axis reads on the audit
  /// and RBAC paths. Kept in sync by `apps/api/src/workers/license-monitor.ts`
  /// — workspace mutations and license-flip events update this so the
  /// resolver doesn't pay the org→subscription join cost per request.
  licenseTier                   UserPlan?
  alerts                        Alert[]
  alertRules                    AlertRule[]
  invitations                   Invitation[]
  servers                       RabbitMQServer[]
  users                         User[]
  members                       WorkspaceMember[]        @relation("WorkspaceMembers")
  licenses                      License[]
  slackConfigs                  SlackConfig[]
  webhooks                      Webhook[]
  digestSettings                WorkspaceDigestSettings?
  digestLogs                    DigestLog[]
  diagnosisRuleConfigs          DiagnosisRuleConfig[]
  configFindings                ConfigFinding[]
  llmConfig                     WorkspaceLlmConfig?
  auditLogs                     AuditLog[]
  roles                         Role[]
  llmExplanations               LlmExplanation[]
  llmUsageCounters              LlmUsageCounter[]
  organization                  Organization              @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

/// Metadata-only trace events from the RabbitMQ Firehose exchange (amq.rabbitmq.trace).
/// Payload is NOT stored here in v1 — see payloadCaptureEnabled on RabbitMQServer.
/// timestamp is populated from the Firehose AMQP header, not from insertion time.
/// Retention: configurable per workspace (traceRetentionHours), default 24h.
model MessageTraceEvent {
  id           String         @id @default(uuid()) /// typically supplied by firehose.service.ts via crypto.randomUUID(); default is a safety net
  /// Monotonically increasing insertion-order column used for cursor pagination
  /// and live-tail polling. UUID v4 ids are random and cannot be used for
  /// stable "id > lastId" ordering — a later insert can sort before an earlier
  /// one under string comparison.
  cursorId     BigInt         @unique @default(autoincrement())
  serverId     String
  vhost        String
  exchange     String
  routingKey   String
  queueName    String?
  payloadBytes Int
  contentType  String?
  messageId    String?
  direction    TraceDirection
  timestamp    DateTime

  server          RabbitMQServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  llmExplanations LlmExplanation[]

  @@index([serverId, cursorId])
  @@index([serverId, direction, cursorId])
  @@index([serverId, vhost, routingKey, cursorId])
  @@index([serverId, timestamp])
  @@index([serverId, direction, timestamp])
  @@index([serverId, vhost, queueName, timestamp])
  @@index([serverId, vhost, exchange, timestamp])
  /// Supports `ORDER BY "cursorId" DESC LIMIT N` over the last N delivers
  /// on a given queue — the access pattern of the drain-lag fetcher
  /// (#firehose-evidence Phase 2 #8). Without this index Postgres falls
  /// back to a heap sort of the queue+direction filtered rowset, which
  /// blows the 300ms statement_timeout on busy queues.
  @@index([serverId, vhost, queueName, direction, cursorId])
  /// Supports pipeline-inference step-2 (#firehose-evidence Phase 3 #12):
  /// `WHERE serverId = ? AND vhost = ? AND direction = 'deliver' AND
  ///  timestamp >= now() - 10min AND messageId = ANY(?)`. Trailing messageId
  /// lets Postgres seek by the leading equality+range and apply ANY() as an
  /// index-only filter — no heap visits unless the messageId matches.
  @@index([serverId, vhost, direction, timestamp, messageId])
  /// NOTE: A PARTIAL sibling index `MessageTraceEvent_unrouted_partial_idx`
  /// supporting unrouted-publishes Query B (#firehose-evidence Phase 3 #4)
  /// is created via raw SQL in the migration
  /// `20260523130000_add_unrouted_publishes_index`:
  ///   CREATE INDEX "MessageTraceEvent_unrouted_partial_idx"
  ///     ON "MessageTraceEvent" ("serverId","vhost","direction","messageId","timestamp")
  ///     WHERE "messageId" IS NOT NULL;
  /// Prisma cannot express partial indexes via `@@index`, and we want the
  /// WHERE clause to skip the cost of indexing untagged firehose rows
  /// (which the per-row NOT EXISTS subquery never seeks). This sibling
  /// of the #12 index reverses the column order so messageId leads the
  /// seek (single-value equality per outer row) with timestamp trailing
  /// as a range. Both indexes coexist because each supports a distinct
  /// production access pattern. Mirrors the partial-index documentation
  /// pattern used for Alert + Role above.
  @@index([timestamp])
}

model WorkspaceLlmConfig {
  workspaceId          String      @id
  provider             LlmProvider
  ollamaEndpoint       String?
  ollamaModel          String?
  endpointOverride     String?
  apiKeyEnc            String?
  encryptionKeyVersion Int         @default(1)
  model                String?
  enabled              Boolean     @default(false)
  updatedAt            DateTime    @updatedAt
  updatedById          String?
  updatedBy            User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  workspace            Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceDigestSettings {
  id            String    @id @default(uuid())
  workspaceId   String    @unique
  enabled       Boolean   @default(false)
  scheduledTime String    @default("08:00")
  frequency     String    @default("daily")
  weeklyDay     Int?
  slackEnabled  Boolean   @default(false)
  recipients    Json?
  lastSentAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model DigestLog {
  id          String    @id @default(uuid())
  workspaceId String
  type        String
  status      String
  error       String?
  sentAt      DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sentAt])
  @@index([sentAt])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  /// FK to `Role` — single-path role resolution. Built-in tiers
  /// resolve to seeded system rows; custom roles (Phase 3 PR-2) live
  /// in workspace-scoped rows. The legacy `role` enum column was
  /// backfilled and dropped in migration
  /// `20260511100000_rbac_phase3_foundation`.
  roleId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation("WorkspaceMembers", fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([roleId])
}

/// RBAC Phase 3 — workspace-scoped role definition.
///
/// Built-ins are seeded once globally with `workspaceId=null,
/// isSystem=true, builtinKey=<tier>`. Custom roles have
/// `workspaceId` set, `isSystem=false`, `builtinKey=null`.
/// `WorkspaceMember.roleId` always points at exactly one row here.
///
/// `@@unique([workspaceId, name])` is INTENTIONALLY NOT declared.
/// Postgres treats NULL as distinct in unique constraints — two
/// system roles named "Owner" with `workspaceId=NULL` would coexist.
/// Two partial unique indexes are created via raw SQL in the
/// migration (case-insensitive `lower(name)`):
///   - one for system rows where `workspaceId IS NULL`
///   - one for custom rows where `workspaceId IS NOT NULL`
model Role {
  id            String            @id @default(uuid())
  workspaceId   String?
  name          String
  description   String?
  isSystem      Boolean           @default(false)
  builtinKey    WorkspaceRole?    @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdById   String?
  workspace     Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  permissions   RolePermission[]
  members       WorkspaceMember[]

  @@index([workspaceId])
  @@index([workspaceId, updatedAt(sort: Desc)])
}

/// RBAC Phase 3 — lookup table for permission keys.
///
/// Seeded by migration from the code manifest at
/// `apps/api/prisma/seed/permissions.ts`. Adding a key in code
/// requires a new migration; renames go through
/// `deprecatedAt`-then-add-new (no in-place rename).
model Permission {
  key          String           @id
  category     String
  description  String
  deprecatedAt DateTime?
  rolePerms    RolePermission[]
}

/// RBAC Phase 3 — many-to-many join with optional scope.
///
/// `scopeFingerprint` is a Postgres GENERATED STORED column
/// computed as `encode(digest(coalesce(scopeCanonical,''),'sha256'),'hex')`.
/// `scopeCanonical` is the app-side canonical text (see
/// `apps/api/src/auth/scope-canonical.ts`) that the caller writes;
/// Postgres hashes it. The `@default(dbgenerated(...))` annotation
/// makes Prisma omit the column from INSERTs so the generated
/// expression fires.
///
/// `@@unique([roleId, permissionKey, scopeFingerprint])` provides
/// OR-across-rows semantics: a role holds permission X for any
/// scope it has a row for, evaluated as a union of scopes.
model RolePermission {
  id               String     @id @default(uuid())
  roleId           String
  permissionKey    String
  scopeJson        Json?
  scopeCanonical   String?
  scopeFingerprint String     @default(dbgenerated("encode(digest(coalesce(\"scopeCanonical\",''),'sha256'),'hex')"))
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission       Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@unique([roleId, permissionKey, scopeFingerprint])
  @@index([permissionKey])
  @@index([roleId])
}

model License {
  id                   String                @id @default(uuid())
  licenseKey           String                @unique
  tier                 UserPlan
  expiresAt            DateTime
  customerEmail        String
  workspaceId          String?
  lastValidatedAt      DateTime?
  isActive             Boolean               @default(true)
  stripeCustomerId     String?
  stripePaymentId      String?
  stripeSubscriptionId String? // Link to annual subscription for auto-renewal
  currentVersion       Int                   @default(1) // Track license file version for renewals
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  renewalEmails        LicenseRenewalEmail[]
  fileVersions         LicenseFileVersion[]

  @@index([isActive], name: "license_active_idx")
  @@index([customerEmail], name: "license_customer_email_idx")
  @@index([licenseKey], name: "license_key_idx")
  @@index([workspaceId], name: "license_workspace_idx")
  @@index([stripeSubscriptionId], name: "license_subscription_idx")
}

model LicenseRenewalEmail {
  id           String   @id @default(uuid())
  licenseId    String
  reminderType String // "30_DAY", "15_DAY", "7_DAY", "EXPIRED"
  sentAt       DateTime @default(now())
  license      License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, reminderType])
  @@index([licenseId])
  @@index([sentAt])
}

model LicenseFileVersion {
  id              String   @id @default(uuid())
  licenseId       String
  version         Int // 1, 2, 3, etc.
  fileContent     String   @db.Text // Signed license JSON
  expiresAt       DateTime
  stripeInvoiceId String? // Stripe invoice ID that triggered this renewal (for idempotency)
  createdAt       DateTime @default(now())
  deletesAt       DateTime // Deletion date - set when a newer version is created
  license         License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, version])
  @@index([licenseId])
  @@index([deletesAt])
  @@index([stripeInvoiceId])
}

model Payment {
  id                String           @id @default(uuid())
  stripePaymentId   String           @unique
  stripeInvoiceId   String?
  stripeChargeId    String?
  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @default("usd")
  status            PaymentStatus
  description       String?
  billingInterval   BillingInterval?
  periodStart       DateTime?
  periodEnd         DateTime?
  paymentMethodId   String?
  paymentMethodType String?
  failureCode       String?
  failureMessage    String?
  receiptUrl        String?
  invoiceUrl        String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  paidAt            DateTime?
  userId            String
  plan              UserPlan?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt], name: "payment_created_at_idx")
  @@index([status], name: "payment_status_idx")
  @@index([stripePaymentId], name: "payment_stripe_id_idx")
  @@index([userId], name: "payment_user_idx")
}

model SlackConfig {
  id          String    @id @default(uuid())
  workspaceId String
  webhookUrl  String
  customValue String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([workspaceId])
}

model StripeWebhookEvent {
  id            String    @id @default(uuid())
  stripeEventId String    @unique
  eventType     String
  processed     Boolean   @default(false)
  data          Json
  processedAt   DateTime?
  errorMessage  String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([eventType], name: "webhook_event_type_idx")
  @@index([processed], name: "webhook_processed_idx")
  @@index([stripeEventId], name: "webhook_stripe_event_idx")
}

/// Per-recipient dedup for "new Qarote release available" emails sent by
/// the release-notifier cron. Prior to this table the cron used a single
/// SystemState row as the gate, which only updated AFTER the recipient
/// loop — a mid-loop crash (or two replicas during a rolling deploy)
/// re-sent the email to recipients who already received it. The unique
/// (releaseVersion, recipient) constraint makes the create() call the
/// gate: P2002 means "this recipient was already notified for this
/// release", and the email send is skipped silently. SystemState is kept
/// as a fast-path early-out so the cron can skip the full recipient
/// query once every license holder has been notified for a version.
model ReleaseNotificationSent {
  id             String   @id @default(uuid())
  releaseVersion String
  recipient      String
  sentAt         DateTime @default(now())

  @@unique([releaseVersion, recipient])
  @@index([releaseVersion])
}

/// Outbox for transactional notifications across multiple channels (email,
/// Slack, user webhooks). Closes dual-write hazards: handlers write the
/// outbox row in the same transaction as the surrounding business state,
/// and an async drain delivers per-channel. `idempotencyKey` is unique
/// across channels — Stripe/alert/cron retries become enqueue-time no-ops.
///
/// `channel` chooses the dispatcher and the retry profile (email tolerates
/// long backoff, webhooks short, Slack respects Retry-After). `target` is
/// the channel-native delivery address (email, Slack URL, webhook URL).
///
/// status: PENDING -> SENT (success) | FAILED (max attempts exceeded)
model NotificationOutbox {
  id             String    @id @default(uuid())
  channel        String
  template       String
  target         String
  payload        Json
  idempotencyKey String    @unique
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  nextAttemptAt  DateTime  @default(now())

  @@index([status, nextAttemptAt], name: "notification_outbox_drain_idx")
  @@index([channel, status], name: "notification_outbox_channel_idx")
}

model Subscription {
  id                   String             @id @default(uuid())
  stripeSubscriptionId String             @unique
  stripePriceId        String
  stripeCustomerId     String
  status               SubscriptionStatus
  billingInterval      BillingInterval
  pricePerMonth        Decimal            @db.Decimal(10, 2)
  currency             String             @default("usd")
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  cancelationReason    String?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  isRenewalAfterCancel Boolean            @default(false)
  previousCancelDate   DateTime?
  userId               String             @unique
  // Nullable during migration. PostgreSQL unique allows multiple NULLs. Will become required after transition.
  organizationId       String?            @unique
  plan                 UserPlan
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status], name: "subscription_status_idx")
  @@index([stripeSubscriptionId], name: "subscription_stripe_id_idx")
  @@index([userId], name: "subscription_user_idx")
}

model Webhook {
  id          String    @id @default(uuid())
  workspaceId String
  url         String
  enabled     Boolean   @default(true)
  secret      String?
  version     String    @default("v1")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([workspaceId])
}

/// Internal process state used by cron jobs to track cursors
/// (e.g. last notified release version).
model SystemState {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Better Auth SSO Plugin Models ──────────────────────────────────

/// Stores OIDC/SAML provider configurations managed by @better-auth/sso.
model SsoProvider {
  id             String   @id @default(cuid())
  issuer         String
  domain         String
  providerId     String   @unique
  oidcConfig     String?  @db.Text
  samlConfig     String?  @db.Text
  userId         String?
  organizationId String?
  domainVerified Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orgSsoConfig OrgSsoConfig?

  @@index([domain])
  @@map("ssoProvider")
}

/// Machine API keys managed by @better-auth/api-key (MCP agent surface).
/// `referenceId` holds the creating user's id (plugin configured with the
/// default `references: "user"`). Scope (workspaceId + read/explain mode)
/// lives in `metadata`. Schema generated by `@better-auth/cli generate`.
model Apikey {
  id                  String    @id      @default(uuid())
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(60000)
  rateLimitMax        Int?      @default(120)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

/// Maps an organization (or the whole instance for self-hosted) to a better-auth SSO provider.
/// organizationId = null means instance-wide (self-hosted only).
model OrgSsoConfig {
  id             String   @id @default(uuid())
  organizationId String?
  providerId     String   @unique
  autoProvision  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     SsoProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum AlertType {
  QUEUE_DEPTH
  MESSAGE_RATE
  UNACKED_MESSAGES
  CONSUMER_COUNT
  CONSUMER_UTILIZATION
  MEMORY_USAGE
  DISK_USAGE
  CONNECTION_COUNT
  CHANNEL_COUNT
  FILE_DESCRIPTOR_USAGE
  NODE_DOWN
  EXCHANGE_ERROR
  SOCKET_USAGE
  PROCESS_USAGE
  RUN_QUEUE_LENGTH
  CONNECTION_CHURN_RATE
  CHANNEL_CHURN_RATE
  QUEUE_CHURN_RATE
  MEMORY_ALARM
  DISK_ALARM
  DLQ_MESSAGES
  NO_CONSUMERS
  /// Sentinel type for AlertRule rows whose evaluator is CONFIG. The
  /// real discriminator is `configRuleKey`; `type` is required so a
  /// stable sentinel keeps existing code paths unchanged.
  CONFIG_RULE
}

enum AlertEvaluator {
  METRIC
  CONFIG
}

enum BillingInterval {
  MONTH
  YEAR
}

enum ComparisonOperator {
  GREATER_THAN
  LESS_THAN
  EQUALS
  NOT_EQUALS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  CANCELED
  REQUIRES_ACTION
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
