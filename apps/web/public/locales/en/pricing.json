  "questions": {
    "title": "Pricing questions",
    "items": {
      "billing": {
        "q": "How does billing work?",
        "a": "Qarote Cloud is a subscription via Stripe — monthly or yearly (yearly saves ~20%). Cancel any time from your billing settings. Community is free forever."
      },
      "selfHostedCloud": {
        "q": "Self-hosted or cloud — what's the difference?",
        "a": "Community is the open-source core: it runs in your network, self-hosted and community-supported. Qarote Cloud is the managed service: it adds AI root-cause analysis, the managed LLM, alerting, and team controls, and it runs on our infrastructure."
      },
      "quota": {
        "q": "What counts toward the AI Explain quota?",
        "a": "Only managed explanations (the zero-config LLM) are metered per month. If you bring your own key, usage is unlimited — you pay your own LLM cost. Repeated identical explanations are cached and don't count."
      },
      "switching": {
        "q": "Can I cancel or change models later?",
        "a": "Yes. Cancel any time; access continues until the end of the billing period. You can switch between the managed LLM and your own key at any moment, and the open-source core keeps running regardless."
      }
    }
  }
