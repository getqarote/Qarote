---
import type { CollectionEntry } from "astro:content";

import PostCover from "@/components/PostCover.astro";
import CtaBand from "@/components/landing/CtaBand";
import FooterIsland from "@/components/FooterIsland";
import { loadTranslations } from "@/lib/i18n-static";
import { getBlogStrings, type BlogCategory } from "./blog-strings";

/** A blog post with its locale prefix already stripped from the slug. */
export interface IndexPost {
  slug: string;
  data: CollectionEntry<"blog">["data"];
}

interface Props {
  locale: string;
  posts: IndexPost[];
}

const { locale, posts } = Astro.props;
const s = getBlogStrings(locale);

const blogBase = locale === "en" ? "/blog" : `/${locale}/blog`;
const signupUrl = `${import.meta.env.VITE_APP_BASE_URL || ""}/auth/sign-up`;
const docsUrl = "/docs/getting-started/";

const footerResources = {
  landing: loadTranslations(locale, "landing"),
  common: loadTranslations(locale, "common"),
  nav: loadTranslations(locale, "nav"),
};

const dateStr = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// Posts arrive sorted newest-first. Split out the featured one; the grid shows
// the rest. Fall back to the newest post if none is flagged featured.
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.slug !== featured?.slug);

const FILTERS: ("all" | BlogCategory)[] = [
  "all",
  "diagnosis",
  "mcp",
  "patterns",
  "engineering",
];
---

<!-- Page head -->
<section class="blogwrap" style="padding-bottom:32px;">
  <span class="eyebrow">{s.eyebrow}</span>
  <h1 class="page-title">{s.title}</h1>
  <p class="page-sub">{s.subtitle}</p>
</section>

<section class="blogwrap" style="padding-top:8px;">
  <div class="blogfilter" role="group" aria-label={s.filters.all}>
    {
      FILTERS.map((cat) => (
        <button class={cat === "all" ? "on" : ""} data-cat={cat} type="button">
          {cat === "all" ? s.filters.all : s.filters[cat]}
        </button>
      ))
    }
  </div>

  {
    featured && (
      <a class="featured" href={`${blogBase}/${featured.slug}/`}>
        <PostCover
          cover={featured.data.cover}
          category={featured.data.category}
          caption={featured.data.coverCaption}
          boxClass="featured__media"
        />
        <div class="featured__body">
          <div class="postmeta">
            <span class="posttag">{s.categories[featured.data.category]}</span>
            <span>{dateStr(featured.data.publishedAt)}</span>
            {featured.data.readingTimeMin && (
              <>
                <span class="sep">·</span>
                <span>
                  {featured.data.readingTimeMin} {s.minReadSuffix}
                </span>
              </>
            )}
          </div>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <div class="postmeta">
            <span>{featured.data.author ?? s.authorName}</span>
          </div>
          <span class="readlink">
            {s.readPost} <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    )
  }

  <div class="postgrid">
    {
      rest.map((post) => (
        <a class="postcard" data-cat={post.data.category} href={`${blogBase}/${post.slug}/`}>
          <PostCover
            cover={post.data.cover}
            category={post.data.category}
            caption={post.data.coverCaption}
            boxClass="postcard__media"
          />
          <div class="postcard__body">
            <div class="postmeta">
              <span class="posttag">{s.categories[post.data.category]}</span>
              <span>{dateStr(post.data.publishedAt)}</span>
              {post.data.readingTimeMin && (
                <>
                  <span class="sep">·</span>
                  <span>
                    {post.data.readingTimeMin} {s.minShort}
                  </span>
                </>
              )}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="postmeta">
              <span>{post.data.author ?? s.authorName}</span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>

<CtaBand
  title={s.ctaTitle}
  subtitle={s.ctaBody}
  primaryLabel={s.ctaPrimary}
  primaryHref={signupUrl}
  secondaryLabel={s.ctaSecondary}
  secondaryHref={docsUrl}
/>

<FooterIsland client:visible locale={locale} resources={footerResources} />

<script>
  // Vanilla category filter — no framework. Clicking a pill marks it active and
  // hides any `.postcard[data-cat]` whose category doesn't match (all = show
  // everything). The featured card is intentionally never filtered. A `?cat=`
  // query param preselects on load (deep-links from elsewhere on the site).
  function applyFilter(cat: string) {
    document.querySelectorAll<HTMLButtonElement>(".blogfilter button").forEach((b) => {
      b.classList.toggle("on", b.dataset.cat === cat);
    });
    document.querySelectorAll<HTMLElement>(".postcard[data-cat]").forEach((card) => {
      const show = cat === "all" || card.dataset.cat === cat;
      card.classList.toggle("hide", !show);
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".blogfilter button").forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.cat || "all"));
  });

  const initial = new URLSearchParams(window.location.search).get("cat");
  const valid = ["all", "diagnosis", "mcp", "patterns", "engineering"];
  if (initial && valid.includes(initial)) applyFilter(initial);
</script>

<style>
  .blogwrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .blogwrap:first-of-type {
    padding-top: 56px;
  }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    margin-bottom: 14px;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.4vw, 46px);
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: hsl(var(--foreground));
  }
  .page-sub {
    margin-top: 16px;
    max-width: 620px;
    font-size: 16px;
    line-height: 1.6;
    color: hsl(var(--secondary-foreground));
    text-wrap: pretty;
  }

  .blogfilter {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 40px;
  }
  .blogfilter button {
    font-size: 13.5px;
    font-weight: 500;
    padding: 8px 15px;
    border-radius: 100px;
    border: 1px solid hsl(var(--input));
    background: transparent;
    color: hsl(var(--secondary-foreground));
    transition: all 0.15s;
    cursor: pointer;
  }
  .blogfilter button:hover {
    border-color: hsl(var(--muted-foreground));
    color: hsl(var(--foreground));
  }
  .blogfilter button.on {
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  .featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    border: 1px solid hsl(var(--border));
    border-radius: 0.625rem;
    overflow: hidden;
    background: hsl(var(--card));
    margin-bottom: 40px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }
  .featured:hover {
    border-color: hsl(var(--input));
  }
  .featured :global(.featured__media) {
    height: 100%;
    min-height: 280px;
  }
  .featured__body {
    padding: clamp(28px, 4vw, 48px);
  }
  .featured__body .postmeta {
    margin-bottom: 14px;
  }
  .featured__body h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: hsl(var(--foreground));
  }
  .featured__body p {
    color: hsl(var(--secondary-foreground));
    font-size: 16px;
    margin: 14px 0 22px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .readlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-weight: 500;
    font-size: 14.5px;
    color: hsl(var(--primary));
  }

  .postgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .postcard {
    display: flex;
    flex-direction: column;
    border: 1px solid hsl(var(--border));
    border-radius: 0.625rem;
    overflow: hidden;
    background: hsl(var(--card));
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      transform 0.12s;
  }
  .postcard:hover {
    border-color: hsl(var(--input));
    transform: translateY(-2px);
  }
  .postcard.hide {
    display: none;
  }
  .postcard :global(.postcard__media) {
    height: 150px;
    border-bottom: 1px solid hsl(var(--border));
  }
  .postcard__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .postcard__body h3 {
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: hsl(var(--foreground));
  }
  .postcard__body p {
    font-size: 13.5px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    flex: 1;
  }

  .postmeta {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: hsl(var(--muted-foreground));
  }
  .postmeta .sep {
    opacity: 0.5;
  }
  .posttag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 100px;
    border: 1px solid hsl(var(--primary) / 0.28);
    background: hsl(var(--accent));
    color: hsl(var(--primary));
  }

  @media (max-width: 900px) {
    .postgrid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured :global(.featured__media) {
      min-height: 180px;
    }
  }
  @media (max-width: 600px) {
    .postgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
