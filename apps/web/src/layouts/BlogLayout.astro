---
import BaseLayout from "./BaseLayout.astro";
import PostCover from "@/components/PostCover.astro";
import FooterIsland from "@/components/FooterIsland";
import { loadTranslations } from "@/lib/i18n-static";
import { getBlogStrings, type BlogCategory } from "@/components/blog/blog-strings";

interface RelatedPost {
  slug: string;
  title: string;
  category: BlogCategory;
  cover?: string;
  coverCaption?: string;
  readingTimeMin?: number;
}

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  author?: string;
  readingTimeMin?: number;
  category: BlogCategory;
  cover?: string;
  coverCaption?: string;
  slug: string;
  locale?: string;
  related?: RelatedPost[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  readingTimeMin,
  category,
  cover,
  coverCaption,
  slug,
  locale = "en",
  related = [],
} = Astro.props;

const s = getBlogStrings(locale);
const blogBase = locale === "en" ? "/blog" : `/${locale}/blog`;
const signupUrl = `${import.meta.env.VITE_APP_BASE_URL || ""}/auth/sign-up`;
const docsUrl = "/docs/getting-started/";

const footerResources = {
  landing: loadTranslations(locale, "landing"),
  common: loadTranslations(locale, "common"),
  nav: loadTranslations(locale, "nav"),
};

const dateStr = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const authorName = author ?? s.authorName;

const baseUrl = "https://qarote.io";
const canonicalBlogPath = `/blog/${slug}/`;
const articleUrl =
  locale === "en"
    ? `${baseUrl}/blog/${slug}/`
    : `${baseUrl}/${locale}/blog/${slug}/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  url: articleUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
  image: "https://qarote.io/images/new_icon.png",
  datePublished: publishedAt,
  dateModified: updatedAt ?? publishedAt,
  author: { "@type": "Person", name: authorName },
  publisher: {
    "@type": "Organization",
    name: "Qarote",
    url: "https://qarote.io/",
    logo: {
      "@type": "ImageObject",
      url: "https://qarote.io/images/new_icon.png",
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={canonicalBlogPath}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
    slot="head"
  />

  <main>
    <article class="post">
      <PostCover
        cover={cover}
        category={category}
        caption={coverCaption}
        boxClass="post__hero"
      />

      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href={`${blogBase}/`}>{s.breadcrumbBlog}</a>
        <span aria-hidden="true">/</span>
        <span class="crumb-cat">{s.categories[category]}</span>
      </nav>

      <div class="post__head">
        <span class="posttag">{s.categories[category]}</span>
        <h1>{title}</h1>
        <div class="post__byline">
          <img
            src="/images/team/brice.jpg"
            alt={authorName}
            class="post__avatar"
            width="40"
            height="40"
          />
          <div class="who">
            <div class="name">{authorName}</div>
            <div class="meta">
              <time datetime={publishedAt}>{dateStr(publishedAt)}</time>
              {
                readingTimeMin && (
                  <>
                    {" · "}
                    {readingTimeMin} {s.minReadSuffix}
                  </>
                )
              }
            </div>
          </div>
        </div>
      </div>

      <div class="prose">
        <slot />
      </div>

      <div class="authorbio">
        <img
          src="/images/team/brice.jpg"
          alt={authorName}
          class="post__avatar post__avatar--lg"
          width="48"
          height="48"
        />
        <div>
          <div class="name">{authorName}</div>
          <div class="role">{s.authorRole}</div>
          <p>{s.authorBio}</p>
        </div>
      </div>

      {
        related.length > 0 && (
          <div class="related">
            <div class="related__h">{s.relatedHeader}</div>
            <div class="related__grid">
              {related.map((r) => (
                <a class="postcard" href={`${blogBase}/${r.slug}/`}>
                  <PostCover
                    cover={r.cover}
                    category={r.category}
                    caption={r.coverCaption}
                    boxClass="postcard__media"
                  />
                  <div class="postcard__body">
                    <div class="postmeta">
                      <span class="posttag">{s.categories[r.category]}</span>
                      {r.readingTimeMin && (
                        <span>
                          {r.readingTimeMin} {s.minShort}
                        </span>
                      )}
                    </div>
                    <h3>{r.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="cta-band">
        <h2>{s.articleCtaTitle}</h2>
        <p>{s.articleCtaBody}</p>
        <div class="cta-row">
          <a class="btn btn--primary" href={signupUrl}>
            {s.ctaPrimary} <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={docsUrl}>{s.articleCtaSecondary}</a>
        </div>
      </div>
    </article>
  </main>

  <FooterIsland client:visible locale={locale} resources={footerResources} />
</BaseLayout>

<script>
  // Code-copy enhancer: wrap every <pre> in the article (plain fenced blocks AND
  // the ones inside <CodeWindow>'s `.codewin`) in a relatively-positioned shell
  // and drop a keyboard-accessible "Copy" button top-right. The button copies
  // the pre's textContent and flashes "Copied".
  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const wrap = document.createElement("div");
    wrap.className = "codecopy-wrap";
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "codecopy";
    btn.textContent = "Copy";
    btn.setAttribute("aria-label", "Copy code");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
        btn.textContent = "Copied";
        window.setTimeout(() => {
          btn.textContent = "Copy";
        }, 1500);
      } catch {
        /* clipboard unavailable (insecure context) — no-op */
      }
    });
    wrap.appendChild(btn);
  });
</script>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 36px 24px 0;
  }

  .post :global(.post__hero) {
    height: clamp(220px, 32vw, 360px);
    border-radius: 0.625rem;
    border: 1px solid hsl(var(--border));
    margin-bottom: 36px;
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 16px;
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  .breadcrumb a:hover {
    color: hsl(var(--primary));
  }
  .breadcrumb .crumb-cat {
    color: hsl(var(--secondary-foreground));
  }

  .post__head {
    text-align: center;
    margin-bottom: 28px;
  }
  .post__head h1 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.4vw, 46px);
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin-top: 16px;
    color: hsl(var(--foreground));
  }
  .post__byline {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    margin-top: 22px;
  }
  .post__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .post__avatar--lg {
    width: 48px;
    height: 48px;
  }
  .post__byline .who {
    text-align: left;
  }
  .post__byline .name {
    font-weight: 600;
    font-size: 14px;
    color: hsl(var(--foreground));
  }
  .post__byline .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }

  .posttag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 100px;
    border: 1px solid hsl(var(--primary) / 0.28);
    background: hsl(var(--accent));
    color: hsl(var(--primary));
  }

  /* Prose — mirrors the prototype article body on tokens. The Callout +
     CodeWindow components carry their own styles. */
  .prose {
    font-size: 16px;
    line-height: 1.7;
    color: hsl(var(--secondary-foreground));
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 24px;
    color: hsl(var(--foreground));
    margin: 32px 0 12px;
    letter-spacing: -0.02em;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 19px;
    color: hsl(var(--foreground));
    margin: 26px 0 10px;
    letter-spacing: -0.01em;
  }
  .prose :global(p) {
    margin: 14px 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 14px 0 14px 4px;
    padding-left: 20px;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin: 7px 0;
  }
  .prose :global(a) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .prose :global(em) {
    font-style: italic;
  }
  /* Inline code only — fenced blocks (inside <pre>) keep their dark chrome. */
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 13.5px;
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    padding: 1px 6px;
    border-radius: 5px;
    color: hsl(var(--accent-foreground));
  }

  /* Code-copy button shell (injected by the enhancer script). */
  .prose :global(.codecopy-wrap) {
    position: relative;
  }
  .prose :global(.codecopy) {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 5px 9px;
    border-radius: 6px;
    border: 1px solid rgba(231, 234, 240, 0.18);
    background: rgba(11, 14, 20, 0.6);
    color: #e7eaf0;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .prose :global(.codecopy-wrap:hover .codecopy),
  .prose :global(.codecopy:focus-visible) {
    opacity: 1;
  }
  .prose :global(.codecopy:focus-visible) {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }

  .authorbio {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 22px;
    border: 1px solid hsl(var(--border));
    border-radius: 0.625rem;
    background: hsl(var(--card));
    margin-top: 40px;
  }
  .authorbio .name {
    font-weight: 600;
    font-size: 15px;
    color: hsl(var(--foreground));
  }
  .authorbio .role {
    font-family: var(--font-mono);
    font-size: 12px;
    color: hsl(var(--primary));
    margin: 2px 0 8px;
  }
  .authorbio p {
    font-size: 13.5px;
    color: hsl(var(--secondary-foreground));
    line-height: 1.55;
  }

  .related {
    margin-top: 48px;
  }
  .related__h {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    margin-bottom: 16px;
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .postcard {
    display: flex;
    flex-direction: column;
    border: 1px solid hsl(var(--border));
    border-radius: 0.625rem;
    overflow: hidden;
    background: hsl(var(--card));
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      transform 0.12s;
  }
  .postcard:hover {
    border-color: hsl(var(--input));
    transform: translateY(-2px);
  }
  .postcard :global(.postcard__media) {
    height: 120px;
    border-bottom: 1px solid hsl(var(--border));
  }
  .postcard__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .postcard__body h3 {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: hsl(var(--foreground));
  }
  .postmeta {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: hsl(var(--muted-foreground));
  }

  .cta-band {
    margin: 48px 0 0;
    text-align: center;
    border: 1px solid hsl(var(--border));
    border-radius: 0.625rem;
    background: hsl(var(--accent));
    padding: clamp(32px, 5vw, 48px);
  }
  .cta-band h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 30px);
    letter-spacing: -0.02em;
    color: hsl(var(--foreground));
  }
  .cta-band p {
    margin: 12px auto 0;
    max-width: 480px;
    color: hsl(var(--secondary-foreground));
    font-size: 15px;
    line-height: 1.6;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 12px 22px;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.15s;
  }
  .btn--primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border: 1px solid hsl(var(--primary));
  }
  .btn--primary:hover {
    background: hsl(var(--primary) / 0.9);
  }
  .btn--ghost {
    background: transparent;
    color: hsl(var(--foreground));
    border: 1px solid hsl(var(--border));
  }
  .btn--ghost:hover {
    border-color: hsl(var(--muted-foreground));
  }

  @media (max-width: 700px) {
    .related__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
