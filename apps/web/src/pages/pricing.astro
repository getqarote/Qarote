---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingIsland from "../components/PricingIsland";
import { loadTranslations } from "../lib/i18n-static";

const resources = {
  common: loadTranslations("en", "common"),
  nav: loadTranslations("en", "nav"),
  landing: loadTranslations("en", "landing"),
  pricing: loadTranslations("en", "pricing"),
};
---

<BaseLayout
  title="Pricing — Qarote RabbitMQ Monitoring"
  description="Free community edition, or unlock advanced monitoring with Developer ($29/mo) and Enterprise plans. Self-host for free, forever."
  canonicalPath="/pricing/"
>
  <PricingIsland resources={resources} client:load />
</BaseLayout>

<script is:inline>
  // Fire `pricing_page_viewed` at most once per browser session — Astro
  // re-runs head scripts on every navigation, so without the sessionStorage
  // gate we'd double-count tab-back / re-enter as fresh views.
  (function () {
    if (typeof window === "undefined") return;
    if (!window.posthog || !window.posthog.capture) return;
    try {
      var KEY = "pricing_page_viewed_sent";
      if (sessionStorage.getItem(KEY)) return;
      sessionStorage.setItem(KEY, "1");
    } catch (_) {
      // sessionStorage may be unavailable (private mode) — fall through and
      // accept the over-count rather than skip the event entirely.
    }
    window.posthog.capture("pricing_page_viewed", { app: "web" });
  })();
</script>
