---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadTranslations } from "../../../lib/i18n-static";
import QuizIsland from "../../../components/QuizIsland";

const resources = {
  quiz: loadTranslations("en", "quiz"),
  common: loadTranslations("en", "common"),
};
---

<BaseLayout
  title="RabbitMQ Skills Assessment — Production-Grade | Qarote"
  description="Your RabbitMQ monitoring is production-grade. You know your brokers — see how Qarote can scale with your team."
  canonicalPath="/quiz/results/production-grade/"
  image="https://qarote.io/og/quiz-production.png"
  nav={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <QuizIsland forceTier="production" resources={resources} client:load />
</BaseLayout>
