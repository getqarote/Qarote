---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadTranslations } from "../../../lib/i18n-static";
import QuizIsland from "../../../components/QuizIsland";

const resources = {
  quiz: loadTranslations("en", "quiz"),
  common: loadTranslations("en", "common"),
};
---

<BaseLayout
  title="RabbitMQ Skills Assessment — Reactive | Qarote"
  description="Your RabbitMQ monitoring is reactive. See what leading indicators you're missing and how to get ahead of incidents."
  canonicalPath="/quiz/results/reactive/"
  image="https://qarote.io/og/quiz-reactive.png"
  nav={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <QuizIsland forceTier="reactive" resources={resources} client:load />
</BaseLayout>
