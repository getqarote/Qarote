---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadTranslations } from "../../../lib/i18n-static";
import QuizIsland from "../../../components/QuizIsland";

const resources = {
  quiz: loadTranslations("en", "quiz"),
  common: loadTranslations("en", "common"),
};
---

<BaseLayout
  title="RabbitMQ Skills Assessment — Proactive | Qarote"
  description="Your RabbitMQ monitoring is proactive. Solid fundamentals — see where the gaps are at depth."
  canonicalPath="/quiz/results/proactive/"
  image="https://qarote.io/og/quiz-proactive.png"
  nav={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <QuizIsland forceTier="proactive" resources={resources} client:load />
</BaseLayout>
