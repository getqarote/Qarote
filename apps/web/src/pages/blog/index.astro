---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogIndex from "@/components/blog/BlogIndex.astro";

// English posts only (those without a locale/ prefix in their id), newest first.
const posts = (await getCollection("blog"))
  .filter((p) => !p.id.includes("/"))
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime()
  )
  .map((p) => ({ slug: p.id, data: p.data }));
---

<BaseLayout
  title="Blog — Debugging RabbitMQ, agent-first"
  description="Field notes on diagnosing RabbitMQ incidents from your editor — MCP guides, root-cause patterns, and agent-native ops."
  canonicalPath="/blog/"
>
  <main>
    <BlogIndex locale="en" posts={posts} />
  </main>
</BaseLayout>
