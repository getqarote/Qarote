---
import { getCollection } from "astro:content";
import { SUPPORTED_LOCALES } from "@qarote/i18n";

import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogIndex from "@/components/blog/BlogIndex.astro";

export async function getStaticPaths() {
  const nonEnglishLocales = SUPPORTED_LOCALES.filter((l) => l !== "en");
  return nonEnglishLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: string };

// Posts for this locale live under content/blog/<locale>/. Strip the prefix so
// the shared index builds locale-aware hrefs from the bare slug.
const posts = (await getCollection("blog"))
  .filter((p) => p.id.startsWith(`${locale}/`))
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt).getTime() -
      new Date(a.data.publishedAt).getTime()
  )
  .map((p) => ({ slug: p.id.slice(locale.length + 1), data: p.data }));

const seoTitles: Record<string, string> = {
  fr: "Blog — Déboguer RabbitMQ, d'abord avec l'agent",
  es: "Blog — Depurando RabbitMQ, agent-first",
  zh: "博客 — RabbitMQ 调试，智能体优先",
};
const seoDescriptions: Record<string, string> = {
  fr: "Notes de terrain sur le diagnostic d'incidents RabbitMQ depuis votre éditeur — guides MCP, schémas de cause racine et opérations natives pour agents.",
  es: "Notas de campo sobre el diagnóstico de incidentes de RabbitMQ desde tu editor — guías MCP, patrones de causa raíz y operaciones nativas para agentes.",
  zh: "在编辑器中诊断 RabbitMQ 故障的实战笔记 — MCP 指南、根因分析模式以及智能体原生运维经验。",
};
---

<BaseLayout
  title={seoTitles[locale] ?? seoTitles["fr"]}
  description={seoDescriptions[locale] ?? seoDescriptions["fr"]}
  locale={locale}
  canonicalPath="/blog/"
>
  <main>
    <BlogIndex locale={locale} posts={posts} />
  </main>
</BaseLayout>
